{
  // Cloudflare Workers Builds 가 `npx wrangler deploy` 로 읽는 설정.
  // main 이 없는 정적 자산 전용 워커다. 빌드가 만든 dist 를 그대로 올린다.
  "name": "luxetherapy",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    // 없는 주소는 dist/404.html 을 보여 준다. 그 쪽은 noindex 로 찍혀 있다.
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
